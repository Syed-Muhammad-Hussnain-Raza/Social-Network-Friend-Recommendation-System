<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="811.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.friendrecommendationsystem.controllers.PostsController">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="20.0" layoutY="20.0" prefHeight="545.0" prefWidth="771.0" spacing="10">
            <!-- Title -->
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Recent Posts" />

            <!-- Scrollable Posts List -->
            <ScrollPane fitToWidth="true" prefHeight="500.0" prefWidth="774.0">
                <content>
                    <VBox fx:id="postsListView" prefHeight="10.0" prefWidth="756.0" spacing="10" style="-fx-padding: 10;" />
                </content>
            </ScrollPane>
        </VBox>
    </children>
</AnchorPane>
